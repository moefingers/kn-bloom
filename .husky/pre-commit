#!/usr/bin/env sh

# Pre-commit: syntax-check the inline script (`pnpm check`) — but SKIP it when
# the staged set is non-code only (docs/images/pdf/…, per the shared allowlist),
# since a docs commit has nothing the check could catch. Any code in the staged
# set runs the check exactly as before. Shares the ONE allowlist with the other
# hooks via .husky/lib/non-code-paths.sh. FAIL SAFE: any uncertainty -> run it.

# Shared "is every path non-code?" allowlist (single source of truth).
# Missing/unreadable -> run the check (fail safe).
. "$(dirname "$0")/lib/non-code-paths.sh" 2>/dev/null || {
  echo "[pre-commit] cannot load non-code allowlist — running check to be safe."
  pnpm check
  exit $?
}

# The staged set (Added/Copied/Modified/Renamed; deletions have no content to
# check). `|| true` so an empty/failed read can't abort under -e.
staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

if [ -n "$staged" ] && all_non_code "$staged"; then
  echo "[pre-commit] non-code-only staged (docs/images/pdf) — skipping check."
  exit 0
fi

pnpm check
